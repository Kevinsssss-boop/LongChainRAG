# 复制成 backend/.env 后填写。注意路径：必须是 backend/ 目录下，不是仓库根目录。
#
# 原因：config.py 里 env_file = ".env" 是**相对进程工作目录**解析的，
# 而 uvicorn 由 start.bat 在 backend/ 下启动。放在仓库根目录的话
# pydantic-settings 不会向上查找，.env 会被**静默忽略** ——
# 程序不报错，继续用默认值，表现为「embedding 401」这类莫名其妙的错误。

# ---- 必填 ----
# 大模型 API Key（OpenAI 兼容接口；默认接阿里云百炼 DashScope）
LLM_API_KEY=sk-your-api-key-here

# JWT 签名密钥。留空时开发环境会随机生成并告警，生产环境直接拒绝启动。
# 生成一个：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# ---- 运行环境 ----
# development / production。
# 设成 production 后：SECRET_KEY 缺失会拒绝启动，不再静默降级。
APP_ENV=development

# ---- 可选 ----
# 使用其他 OpenAI 兼容服务时填写（如 https://dashscope.aliyuncs.com/compatible-mode/v1）
LLM_BASE_URL=
LLM_MODEL_NAME=qwen-plus
EMBEDDING_MODEL_NAME=text-embedding-v3

# 管理员账号。ADMIN_PASSWORD 留空时，首次启动会随机生成一个并打印一次。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---- 调参 ----
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=10
FINAL_TOP_K=6
CACHE_SIMILARITY_THRESHOLD=0.92
RATE_LIMIT_PER_MINUTE=30
MAX_UPLOAD_SIZE_MB=50
